server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # One origin for the browser: the SPA and its API. The API is the compose
    # service named `api`; the port is substituted from RECIPES_API_PORT.
    location /api/ {
        proxy_pass http://api:${RECIPES_API_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Chat responses will stream; don't hold them back.
        proxy_buffering off;
    }

    # Vite fingerprints everything under /assets, so it can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routing: unknown paths get the app shell, never cached.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
