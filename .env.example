# Opinionated Recipes — configuration.
#
# Copy to .env and edit. Every variable is optional unless marked REQUIRED;
# the value shown is the default the app uses when the variable is unset or
# empty. packages/config/src/index.ts is the authoritative list — keep this
# file in step with it.
#
# Never commit .env. Secrets below are left blank on purpose.

# ---------------------------------------------------------------------------
# Compose (read by docker compose, not by the apps)
# ---------------------------------------------------------------------------

# Run behind Traefik instead of publishing a host port (see compose.traefik.yaml).
# COMPOSE_FILE=compose.yaml:compose.traefik.yaml

# REQUIRED for docker compose. Letters and digits only, or URL-encode it: it is
# embedded in RECIPES_DATABASE_URL.
RECIPES_POSTGRES_PASSWORD=
# RECIPES_POSTGRES_USER=recipes
# RECIPES_POSTGRES_DB=recipes

# Where the web container is published when not behind Traefik.
# RECIPES_HTTP_BIND=127.0.0.1
# RECIPES_HTTP_PORT=8080

# compose.traefik.yaml only.
# RECIPES_DOMAIN=recipes.localhost
# RECIPES_TRAEFIK_NETWORK=traefik
# RECIPES_TRAEFIK_ENTRYPOINT=websecure

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# fatal | error | warn | info | debug | trace | silent
# RECIPES_LOG_LEVEL=info
# RECIPES_API_HOST=0.0.0.0
# RECIPES_API_PORT=3000

# The URL people open in their browser. Used to build OIDC redirect URLs.
# RECIPES_PUBLIC_URL=http://localhost:8080

# For running the apps directly on the host. Inside docker compose these are
# overridden with the compose service addresses. The default carries no
# credentials; when running on the host, set user and password here, e.g.
#   RECIPES_DATABASE_URL=postgres://recipes:<RECIPES_POSTGRES_PASSWORD>@localhost:5432/recipes
# RECIPES_DATABASE_URL=postgres://localhost:5432/recipes
# RECIPES_REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# OIDC wins: once all three RECIPES_OIDC_* are set, the fallback password is
# ignored entirely. Setting only some of them is a startup error.

# Fallback shared password, used only while OIDC is not configured.
RECIPES_AUTH_PASSWORD=
# At least 32 characters. Signs session cookies. e.g. `openssl rand -base64 48`
RECIPES_SESSION_SECRET=

RECIPES_OIDC_ISSUER_URL=
RECIPES_OIDC_CLIENT_ID=
RECIPES_OIDC_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Ollama (local embeddings; used when RECIPES_FEATURE_RAG is on)
# ---------------------------------------------------------------------------

# Inside docker compose the default is http://ollama:11434 (the `ollama` profile).
# RECIPES_OLLAMA_URL=http://localhost:11434
# Starting point only — which model suits your hardware is an open question.
# RECIPES_OLLAMA_EMBED_MODEL=nomic-embed-text

# ---------------------------------------------------------------------------
# Claude (chat; used when RECIPES_FEATURE_CHAT is on)
# ---------------------------------------------------------------------------
# Recipe content leaves this host only when chat is switched on and used.

RECIPES_ANTHROPIC_API_KEY=
# REQUIRED when chat is on: a current Claude model ID.
RECIPES_CLAUDE_MODEL=

# ---------------------------------------------------------------------------
# Feature switches (true/false, on/off, 1/0, yes/no)
# ---------------------------------------------------------------------------

# OpenAPI document and interactive docs at /api/docs
# RECIPES_FEATURE_API_DOCS=true
# Import a recipe from a web page
# RECIPES_FEATURE_IMPORT_URL=true
# Import .cook files and other apps' exports
# RECIPES_FEATURE_IMPORT_FILE=true
# Export recipes as .cook files
# RECIPES_FEATURE_EXPORT=true
# Embeddings via Ollama + pgvector, for semantic search and chat context
# RECIPES_FEATURE_RAG=false
# Talk to your recipes through Claude (needs the Claude settings above)
# RECIPES_FEATURE_CHAT=false
# Share a recipe outside this instance
# RECIPES_FEATURE_SHARE=false
